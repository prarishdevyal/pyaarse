# --- Supabase (Project → Connect) ---
# Session pooler URI (IPv4): Connect → Direct → Session pooler (port 5432) for Docker/a server.
# On Vercel use the Transaction pooler URI (port 6543) instead.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# --- URLs ---
SITE_URL=http://localhost:3000
# Used for the "Open in admin" link in Telegram messages
ADMIN_URL=http://admin.localhost:3000

# --- Admin account (created on first start; change later with `npm run admin:password`) ---
# At least 12 characters. The example value is refused.
ADMIN_EMAIL=admin@pyaarse.net
ADMIN_PASSWORD=

# --- Email: SMTP when SMTP_HOST is set (Mailpit locally), otherwise Resend if RESEND_API_KEY is set ---
# Zoho (India): SMTP_HOST=smtp.zoho.in, SMTP_PORT=465, SMTP_USER=<mailbox>@pyaarse.net, SMTP_PASS=<Zoho app password>
# Leave MAIL_FROM empty to send as SMTP_USER; any other address must be an alias of that mailbox.
RESEND_API_KEY=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# New-order alert emails go here (defaults to SMTP_USER)
ORDER_ALERT_EMAIL=
MAIL_FROM=Pyaarse <orders@pyaarse.net>

# --- Unpaid orders release their stock after this many hours ---
PENDING_ORDER_TTL_HOURS=24

# --- Telegram (leave empty to just log messages) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Contact page ---
STORE_WHATSAPP=
STORE_EMAIL=hello@pyaarse.net
STORE_INSTAGRAM=pyaarse

# --- Vercel Cron: daily /api/keepalive ping so the free Supabase project doesn't pause ---
# Any long random string (e.g. `openssl rand -hex 32`). Set the same value in Vercel.
CRON_SECRET=
