{
  "name": "pyaarse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "tsx scripts/seed.mts",
    "start:docker": "tsx scripts/migrate.mts && tsx scripts/seed.mts && next start -H 0.0.0.0 -p 3000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "admin:password": "tsx scripts/set-admin-password.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "nodemailer": "^10.3.1",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
